{
  "name": "nest-crud-demo",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint --fix .",
    "pre-commit": "npm run lint && npm run format && npm run build",
    "typeorm": "typeorm -d dist/config/typeorm.config.js",
    "migration:generate": "npm run build && node scripts/generate-migration.js",
    "migration:create": "npm run typeorm migration:create src/database/migrations/",
    "migration:run": "npm run build && npm run typeorm migration:run",
    "migration:revert": "npm run build && npm run typeorm migration:revert",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeder/seeder.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1037.0",
    "@aws-sdk/client-kms": "^3.1037.0",
    "@aws-sdk/client-secrets-manager": "^3.1037.0",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/typeorm": "^11.0.1",
    "bip39": "^3.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "jwks-rsa": "^4.0.1",
    "mysql2": "^3.22.3",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@types/cron": "^2.0.1",
    "@types/node": "^25.6.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "pm2": "^7.0.3",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  }
}
